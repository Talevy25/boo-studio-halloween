# Copy to .env.local (Git-ignored). Never commit real values.
# Personal access token from the Boo Studio workspace: Settings → Secrets → Personal access tokens.
# Access: All apps and Superagents. Permission: Full access.
BASE44_ACCESS_TOKEN=
# The Boo Studio workspace ID (not your personal workspace). Sent as X-Active-Workspace-Id.
BASE44_WORKSPACE_ID=
# Base44 HTTPS origin the server calls.
BASE44_PLATFORM_HOST=https://app.base44.com
